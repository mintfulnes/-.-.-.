rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Sessions collection for anonymous participant research
    match /sessions/{sessionId} {
      // Allow participant or researcher to fetch their own session by code
      allow get: if isValidId(sessionId);

      // Block list across all documents to prevent data scraping, unless admin
      allow list: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));

      // Allow creating an anonymous session document with valid structure
      allow create: if isValidId(sessionId)
        && request.resource.data.keys().hasAll(['group', 'order', 'survey', 'startedAt', 'device', 'items'])
        && request.resource.data.group in ['A', 'B']
        && request.resource.data.order is list
        && request.resource.data.order.size() == 4
        && request.resource.data.survey is map
        && request.resource.data.items is map
        && request.resource.data.startedAt is string
        && request.resource.data.device is string;

      // Allow updating session progress (items interactions, phase1CompletedAt, phase2)
      allow update: if isValidId(sessionId)
        && request.resource.data.group == resource.data.group
        && request.resource.data.order == resource.data.order
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'phase1CompletedAt', 'phase2', 'updatedAt']);

      allow delete: if false;
    }
  }
}
